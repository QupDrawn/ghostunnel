# /etc/ghostunnel/ring.env: the operator's own values for ghostunnel.service,
# and for it alone. Copy to /etc/ghostunnel/ring.env, mode 0644 root:root:
# gt reads it, and it holds no secret (addresses, paths and an ACL flag;
# never a passphrase, which would also fail the admin observer's cmdline
# check if passed as a flag). Every variable must be set: the unit refuses
# to start on an empty one (ExecStartPre), because an empty ${VAR} in
# ExecStart would silently shift the next flag into its place.
#
# No observer reads this file. What the tunnel observer EXPECTS the listener
# and ACL to be lives in /etc/ghostunnel/observers.env (observers.env.example),
# written from a different source and reviewed separately: an expectation
# copied from here would compare the proxy's configuration with itself.

# The mTLS listener. If this changes, observers.env must change too, or the
# tunnel observer halts (that is the design, not a nuisance).
# TCP, as is GT_STATUS below. ghostunnel.service runs under UMask=0027 so
# that the trace it writes under gt/ is readable by its group alone; a
# unix:PATH listener or status socket would be created under the same umask,
# 0750 gt:gt, and only gt and root could connect to it.
GT_LISTEN=0.0.0.0:8443

# The backend ghostunnel forwards to (HOST:PORT or unix:PATH).
GT_TARGET=127.0.0.1:8080

# PEM files. Only PEM cert/key/CA/policy files on disk satisfy the material
# observer's material-loaded: no --keystore, PKCS#11, keychain, SPIFFE or
# ACME. cert, CA and policy are root:gtring-pem 0640 so the observers can hash
# them and re-verify served handshakes against the CA; the key is root:gt 0640
# so no observer can read it (it is only stat'ed).
GT_CERT=/etc/ghostunnel/cert.pem
GT_KEY=/etc/ghostunnel/key.pem
GT_CACERT=/etc/ghostunnel/ca.pem

# The status listener. MUST be loopback: the admin observer's
# status-listener-bound accepts only loopback (or client-cert-required), and
# ghostunnel reports status_client_cert false, so a routable address halts the
# ring. TLS with the server certificate; do not prefix http://.
GT_STATUS=127.0.0.1:8444

# The access-control flags, word-split into ExecStart as $GT_ACL. ghostunnel
# server refuses to start without one. Example: --allow-cn client.example.com
# or --allow-policy /etc/ghostunnel/policy.rego --allow-query 'data.policy.allow'
# The same rules, in the start line's form (allow-cn:client.example.com), are
# what observers.env GT_EXPECT_ACL must hold; a mismatch halts the ring.
GT_ACL=--allow-cn client.example.com

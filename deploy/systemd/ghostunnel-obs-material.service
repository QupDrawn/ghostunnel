# ghostunnel-obs-material.service: the material member, as user gtobs-material.
# Its writes are exactly the gtobs-material rows of deploy/write-matrix.tsv.
#
# Outside the tree it reads the PEM files named in ghostunnel's start line:
# cert, CA and policy are read whole and hashed (root:gtring-pem 0640, and
# gtobs-material is in gtring-pem); the key is only stat'ed (root:gt 0640, so
# this user cannot read it). /etc is read-only under ProtectSystem=strict.
[Unit]
Description=ghostunnel observer ring: material member
Documentation=file:///usr/share/doc/ghostunnel-ring/README.md
PartOf=ghostunnel-ring.target
After=local-fs.target

[Service]
Type=simple
User=gtobs-material
Group=gtobs-material
# Supplementary groups from /etc/group (setup-tree.sh): gtring-halts-tunnel,
# gtring-halts-admin, gtring-halts-super, gtring-pem.
# gt/ is gt:gtring-trace 0750 (tree.tsv): the trace is read through this
# group and by nobody outside it. Stated here so check-units.sh --static can
# refuse a unit without it (see ghostunnel-obs-tunnel.service).
SupplementaryGroups=gtring-trace
UMask=0022
# observers.env for GT_EXPECT_POLICY_QUERY alone: every member re-judges
# the tunnel surface, so the policy query is one value on all four. It is
# the operator's expectation, never the proxy's own file. Passed with = so an empty
# value (no policy deployed) cannot shift the next flag into its place.
EnvironmentFile=/etc/ghostunnel/observers.env
# -slot-owners is the account each member runs as, the User= of each
# member's unit: an entry of this member's own halts/ named for a member
# must be owned by that account (SPEC 10.2 H7), which is what makes a slot
# created under another member's name the owner's own failing check (I8)
# rather than a silent halt.
# check-units.sh --static requires the mapping to equal the units' User=.
ExecStart=/usr/local/bin/ghostunnel-obs-material \
    -identity material \
    -members tunnel,admin,material,super \
    -coordinator super \
    -copy-authors tunnel=material,admin=tunnel,material=admin \
    -slot-owners tunnel=gtobs-tunnel,admin=gtobs-admin,material=gtobs-material,super=gtobs-super \
    -stores /var/lib/ghostunnel-ring/stores \
    -traces /var/lib/ghostunnel-ring/stores/gt \
    -window 4 \
    -min-cycle 300ms \
    -cadence 10 \
    -heartbeat-max-age 30s \
    -policy-query=${GT_EXPECT_POLICY_QUERY}
Restart=on-failure
RestartSec=2s

# ---- sandbox ----------------------------------------------------------------
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
# boot-ambiguous stats /proc/<pid> of the process each boot's start line
# names; see ghostunnel-obs-tunnel.service. ProtectProc=invisible would
# hide ghostunnel's pid and the member would halt on its own blindness.
ProtectProc=default
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
ReadOnlyPaths=/var/lib/ghostunnel-ring/stores
# Own store. (row: material)
ReadWritePaths=/var/lib/ghostunnel-ring/stores/material
# The one peer copy material authors: copy-authors tunnel=material. (row: tunnel/copy)
ReadWritePaths=/var/lib/ghostunnel-ring/stores/tunnel/copy
# material's own copy in the coordinator's store. (row: super/copy-material)
ReadWritePaths=/var/lib/ghostunnel-ring/stores/super/copy-material
# The halts/ of every other member: only the slot halts/material and its .tmp.
ReadWritePaths=/var/lib/ghostunnel-ring/stores/tunnel/halts
ReadWritePaths=/var/lib/ghostunnel-ring/stores/admin/halts
ReadWritePaths=/var/lib/ghostunnel-ring/stores/super/halts
# Other members' directories inside the own store, remasked read-only.
ReadOnlyPaths=/var/lib/ghostunnel-ring/stores/material/copy
ReadOnlyPaths=/var/lib/ghostunnel-ring/stores/material/copy-super
ReadOnlyPaths=/var/lib/ghostunnel-ring/stores/material/halts

[Install]
WantedBy=ghostunnel-ring.target
